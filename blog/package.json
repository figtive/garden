{
  "name": "blog",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx --env-file-if-exists=.env build.ts",
    "watch": "tsx watch --env-file-if-exists=.env --include \"./public/**\" --include \"./content/**\" --include \"./**/*.client.ts\" --include \"./component/**/*.ts\" --include \"./utils/**/*.ts\" build.ts",
    "serve": "browser-sync start --server dist --files \"dist/**/*\" --no-notify --reload-debounce 300",
    "typecheck": "tsc",
    "dev": "concurrently -n build,serve -c magenta,yellow \"pnpm watch\" \"pnpm serve\""
  },
  "dependencies": {
    "@figtive/garden-engine": "workspace:*",
    "minisearch": "^7.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "browser-sync": "^3.0.4",
    "concurrently": "^10.0.6"
  }
}
