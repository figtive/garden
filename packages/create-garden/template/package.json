{
  "name": "garden-template",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "garden build",
    "dev": "concurrently -n build,serve -c magenta,yellow \"npm run watch\" \"npm run serve\"",
    "serve": "browser-sync start --server dist --files \"dist/**/*\" --no-notify --reload-debounce 300",
    "typecheck": "tsc",
    "watch": "tsx watch --env-file-if-exists=.env --include \"./public/**\" --include \"./content/**\" --include \"./**/*.client.ts\" --include \"./component/**/*.ts\" --include \"./utils/**/*.ts\" build.ts"
  },
  "dependencies": {
    "@figtive/garden-engine": "workspace:*",
    "minisearch": "^7.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "browser-sync": "^3.0.4",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
