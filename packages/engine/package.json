{
  "name": "@figtive/garden-engine",
  "version": "0.1.0",
  "description": "A static site generator for blogs, with React components in Markdown.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figtive/garden.git",
    "directory": "packages/engine"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli/index.ts"
  },
  "files": [
    "bin",
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./cli": "./dist/cli/index.js"
    }
  },
  "scripts": {
    "test": "vitest",
    "typecheck": "tsc",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build"
  },
  "bin": {
    "garden": "./bin/garden.js"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "globby": "^16.2.4",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shiki": "^4.5.0",
    "tsx": "^4.23.15",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
